# URL of the wink-user-dashboard deployment (no trailing slash)
# Used to build login/signup CTA links on the landing page
VITE_APP_URL=https://wink-user-dashboard.workers.dev

# Supabase project URL + anon (publishable) key, used by the /waitlist form to
# write to the public.waitlist_signups table. Both are PUBLIC values — the
# anon key is designed to be embedded in client-side bundles. The waitlist
# table's RLS policy allows insert-only from anon.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
